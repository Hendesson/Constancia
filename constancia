        # --- janela de histórico, resumo e progresso ---
        def abrir_historico():
            w = janela_auxiliar("historico", "Histórico e progresso", 580, 700)
            if not w:
                return
            dados = {"a": Atividade()}
            pagina = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                             margin_top=18, margin_bottom=18, margin_start=22, margin_end=22)
            w.set_child(pagina)

            chaves = list(PERIODOS)
            periodo = Gtk.DropDown.new_from_strings(list(PERIODOS.values()))
            periodo.set_selected(chaves.index("semana"))
            cabecalho = Gtk.Box(spacing=12)
            cabecalho.append(rotulo("Resumo de", "constancia-dia", margin_top=0))
            cabecalho.append(periodo)
            pagina.append(cabecalho)
            numeros_grade = Gtk.Grid(row_spacing=14, column_spacing=12, column_homogeneous=True)
            pagina.append(numeros_grade)

            pagina.append(rotulo("Tarefas concluídas por semana", "constancia-dia"))
            barras = Gtk.DrawingArea(content_height=130, hexpand=True)

            def desenhar(_a, cr, largura, altura):
                cor_texto = barras.get_color() if tem(barras, "get_color") else \
                    barras.get_style_context().get_color()
                desenhar_barras(cr, largura, altura, dados["a"].por_semana(12), rgb(cfg["grafico"]),
                                (cor_texto.red, cor_texto.green, cor_texto.blue))

            barras.set_draw_func(desenhar)
            pagina.append(barras)

            pagina.append(rotulo("Dia a dia", "constancia-dia"))
            dias = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_end=12)
            pagina.append(Gtk.ScrolledWindow(child=dias, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))

            def preencher(*_):
                a, chave = dados["a"], chaves[periodo.get_selected()]
                esvaziar(numeros_grade)
                for i, (valor, legenda) in enumerate(linhas_do_resumo(a, chave)):
                    bloco = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    bloco.append(rotulo(str(valor), "constancia-numero"))
                    bloco.append(rotulo(legenda, "constancia-legenda", wrap=True))
                    numeros_grade.attach(bloco, i % 3, i // 3, 1, 1)
                esvaziar(dias)
                ativos = a.resumo(chave)["dias"][::-1][:366]
                if not ativos:
                    dias.append(rotulo("Nenhuma atividade neste período.", "constancia-legenda"))
                for d in ativos:
                    dias.append(rotulo(data_longa(d), "constancia-dia"))
                    feitas = a.historico.get(d.isoformat(), [])
                    for t in feitas:
                        dias.append(rotulo(f"✔  {t}", wrap=True))
                    if not feitas:
                        dias.append(rotulo("usou o computador, nenhuma tarefa concluída", "constancia-legenda"))
                barras.queue_draw()

            periodo.connect("notify::selected", preencher)

            aviso = rotulo("", "constancia-legenda", wrap=True, hexpand=True)

            def compartilhar(*_):
                aviso.set_label(f"Imagem salva em {compartilhar_imagem(True)} e copiada: "
                                "é só colar onde quiser compartilhar.")

            def confirmar_exclusao():
                excluir_historico()
                dados["a"] = Atividade()
                preencher()
                recarregar()
                aviso.set_label("Histórico excluído.")

            def ao_responder(dialogo, resultado):
                try:
                    escolha = dialogo.choose_finish(resultado)
                except GLib.Error:
                    return
                if escolha == 1:
                    confirmar_exclusao()

            def ao_responder_antigo(dialogo, escolha):
                dialogo.destroy()
                if escolha == 1:
                    confirmar_exclusao()

            def excluir(*_):
                pergunta = "Excluir todo o histórico?"
                detalhe = ("Os dias de uso e as tarefas concluídas serão apagados, neste computador e nos "
                           "sincronizados. As tarefas pendentes e o desenho ficam. Isso não pode ser desfeito.")
                if tem(Gtk, "AlertDialog"):
                    dialogo = Gtk.AlertDialog(message=pergunta, detail=detalhe, buttons=["Cancelar", "Excluir"],
                                              cancel_button=0, default_button=0)
                    dialogo.choose(w, None, ao_responder)
                else:
                    dialogo = Gtk.MessageDialog(transient_for=w, modal=True, message_type=Gtk.MessageType.QUESTION,
                                                text=pergunta, secondary_text=detalhe)
                    dialogo.add_button("Cancelar", 0)
                    dialogo.add_button("Excluir", 1)
                    dialogo.connect("response", ao_responder_antigo)
                    dialogo.present()

            rodape = Gtk.Box(spacing=12)
            b_compartilhar = Gtk.Button(label="Compartilhar imagem")
            b_compartilhar.connect("clicked", compartilhar)
            b_excluir = Gtk.Button(label="Excluir histórico…")
            b_excluir.add_css_class("destructive-action")
            b_excluir.connect("clicked", excluir)
            for x in (aviso, b_compartilhar, b_excluir):
                rodape.append(x)
            pagina.append(rodape)
            preencher()
            w.present()

        # Quando os arquivos mudam (pelo painel, pelo terminal ou pela sincronização):
        # recarrega logo e sincroniza alguns segundos depois
        def ao_mudar(*_):
            if not estado.get("pendente"):
                estado["pendente"] = GLib.timeout_add(200, recarregar)
            if estado.get("sync_timer"):
                GLib.source_remove(estado["sync_timer"])

            def disparar():
                estado["sync_timer"] = 0
                sincronizar_em_segundo_plano()
                return False

            estado["sync_timer"] = GLib.timeout_add_seconds(8, disparar)

        os.makedirs(DIR, exist_ok=True)
        estado["monitor"] = Gio.File.new_for_path(DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        estado["monitor"].connect("changed", ao_mudar)

        def periodico():
            if not tela_bloqueada():
                marcar_hoje()
            atualizar_clima()
            recarregar()
            sincronizar_em_segundo_plano()
            return True

        marcar_hoje()
        aplicar_aparencia()
        recarregar()
        atualizar_clima()
        sincronizar_em_segundo_plano()
        GLib.timeout_add_seconds(600, periodico)
        GLib.timeout_add_seconds(20, verificar_alarmes)
        # Fechar só esconde o painel: o programa segue em segundo plano (alarmes, lembrete,
        # sincronização) e abrir o Constância de novo pelo ícone mostra o painel outra vez.
        def ao_fechar_painel(*_):
            janela.set_visible(False)
            if not ler_json(ESTADO).get("avisou_segundo_plano"):
                gravar_json(ESTADO, dict(ler_json(ESTADO), avisou_segundo_plano=True))
                notificar("O Constância continua em segundo plano",
                          "Abra de novo pelo ícone do aplicativo. Para encerrar de vez, use as configurações.",
                          "segundo-plano")
            return True

        janela.connect("close-request", ao_fechar_painel)
        estado["janela"] = janela
        app.hold()
        janela.present()

    app = Gtk.Application(application_id=APP_ID)
    app.connect("activate", ao_ativar)
    return app.run(None)


# ---------- linha de comando ----------

def main():
    cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
    if cmd == "painel":
        sys.exit(painel())
    elif cmd == "marcar":
        if not tela_bloqueada():
            marcar_hoje()
    elif cmd in ("add", "a"):
        if not " ".join(args).strip():
            sys.exit("Uso: constancia add TEXTO DA TAREFA")
        adicionar(" ".join(args))
        mostrar_tarefas()
    elif cmd in ("ok", "feito", "rm"):
        for t in retirar(numeros(args), concluir=cmd != "rm"):
            print(fraco(("✘ " if cmd == "rm" else "✔ ") + t))
        mostrar_tarefas()
    elif cmd == "alarme":
        if len(args) < 2:
            sys.exit('Uso: constancia alarme N HORA   (ex.: "14:30", "25/12 09:00" ou "nenhum")')
        n = numeros(args[:1])[0]
        try:
            alarme = "" if args[1] == "nenhum" else interpretar_alarme(" ".join(args[1:]))
        except ValueError as e:
            sys.exit(f"Horário inválido: {e}")
        definir_alarme(ler_tarefas()[n - 1]["id"], alarme)
        mostrar_tarefas()
    elif cmd in ("tarefas", "ls"):
        mostrar_tarefas()
    elif cmd in ("grafico", "gráfico"):
        marcar_hoje()
        mostrar_grafico()
    elif cmd == "resumo":
        mostrar_resumo(args[0] if args else "semana")
    elif cmd == "compartilhar":
        so_grafico = "--grafico" in args
        arquivos = [x for x in args if x != "--grafico"]
        print("Imagem salva em " + gerar_imagem(
            arquivos[0] if arquivos else f"constancia-{date.today().isoformat()}.png", com_resumo=not so_grafico))
    elif cmd == "sync":
        ok, mensagem = sincronizar(ler_config()["sync_repo"])
        print(mensagem)
        sys.exit(0 if ok else 1)
    elif cmd == "clima":
        mostrar_clima(forcar="-f" in args)
    elif cmd == "cidade":
        nome = " ".join(args).strip()
        if not nome:
            sys.exit('Uso: constancia cidade NOME   (ou "constancia cidade auto")')
        if nome == "auto":
            if os.path.exists(CIDADE):
                os.remove(CIDADE)
        else:
            gravar(CIDADE, [nome])
        mostrar_clima(forcar=True)
    elif cmd == "":
        marcar_hoje()  # se você está vendo isto, o computador está em uso
        mostrar_tarefas()
        print()
        mostrar_grafico()
    elif cmd in ("ajuda", "help", "-h", "--help"):
        print(AJUDA)
    elif cmd in ("--version", "-V"):
        print(f"constancia {VERSAO}")
    else:
        sys.exit(f"Comando desconhecido: {cmd}\n\n{AJUDA}")


if __name__ == "__main__":
    main()
