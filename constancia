# ---------- sincronização (repositório git, ex.: GitHub privado) ----------

def mesclar(a, b):
    """Une os dados das pastas `a` e `b` e deixa as duas iguais."""
    def linhas(pasta, nome):
        return ler(os.path.join(pasta, nome))

    limpeza = max(linhas(a, "limpeza.txt")[:1] + linhas(b, "limpeza.txt")[:1], default="")
    uso = sorted({d for d in linhas(a, "uso.txt") + linhas(b, "uso.txt") if d >= limpeza[:10]})

    # Concluídas: uma por id; as antigas (sem id) valem pela contagem maior das duas pastas
    com_id, sem_id = {}, Counter()
    for pasta in (a, b):
        antigas = Counter()
        for l in linhas(pasta, "concluidas.tsv"):
            c = l.split("\t")
            momento = c[3] if len(c) > 3 else c[0] + "T00:00:00"
            if momento < limpeza:
                continue
            if len(c) > 2 and c[2]:
                if c[2] not in com_id or momento < com_id[c[2]][0]:
                    com_id[c[2]] = (momento, l)
            else:
                antigas[l] += 1
        sem_id |= antigas
    concluidas = sorted(sem_id.elements()) + [l for _, l in sorted(com_id.values())]

    removidas = sorted(set(linhas(a, "removidas.txt")) | set(linhas(b, "removidas.txt")))
    tarefas, vistas = [], set(removidas)
    for l in linhas(a, "tarefas.tsv") + linhas(b, "tarefas.tsv"):  # em conflito, vale a de `a`
        if l.split("\t")[0] not in vistas:
            vistas.add(l.split("\t")[0])
            tarefas.append(l)
    tarefas.sort(key=lambda l: l.split("\t")[0])

    da, db = linhas(a, "desenho.txt"), linhas(b, "desenho.txt")
    desenho = db if db[:1] > da[:1] else da  # vale o desenho editado por último

    for nome, conteudo in (("uso.txt", uso), ("concluidas.tsv", concluidas), ("removidas.txt", removidas),
                           ("tarefas.tsv", tarefas), ("desenho.txt", desenho),
                           ("limpeza.txt", [limpeza] if limpeza else [])):
        for pasta in (a, b):
            if conteudo or os.path.exists(os.path.join(pasta, nome)):
                gravar(os.path.join(pasta, nome), conteudo)


def _git(*args, cwd=None):
    ambiente = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    ambiente.setdefault("GIT_SSH_COMMAND", "ssh -oBatchMode=yes -oConnectTimeout=10")
    try:
        return subprocess.run(["git", *args], cwd=cwd, env=ambiente, capture_output=True, text=True, timeout=90)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 1, "", "tempo esgotado")


def _erro(r):
    linhas = [l for l in (r.stderr or r.stdout).strip().splitlines() if l.strip()]
    return linhas[-1] if linhas else "erro desconhecido"


def sincronizar(repo):
    """Envia e recebe os dados pelo repositório git `repo`. Devolve (deu_certo, mensagem)."""
    if not repo:
        return False, "Nenhum repositório configurado."
    if not shutil.which("git"):
        return False, "O git não está instalado."
    ler_tarefas()  # converte a lista do formato antigo, se ainda existir
    if os.path.isdir(SYNC) and _git("remote", "get-url", "origin", cwd=SYNC).stdout.strip() != repo:
        shutil.rmtree(SYNC)
    if not os.path.isdir(SYNC):
        os.makedirs(os.path.dirname(SYNC), exist_ok=True)
        r = _git("clone", "--quiet", repo, SYNC)
        if r.returncode:
            shutil.rmtree(SYNC, ignore_errors=True)
            return False, "Não consegui acessar o repositório: " + _erro(r)
        _git("checkout", "-q", "-B", "main", cwd=SYNC)
    identidade = [] if _git("config", "user.email", cwd=SYNC).stdout.strip() else \
        ["-c", "user.name=constancia", "-c", "user.email=constancia@localhost"]
    r = None
    for _tentativa in range(2):
        r = _git("fetch", "--quiet", "origin", cwd=SYNC)
        if r.returncode:
            return False, "Sem acesso ao repositório: " + _erro(r)
        if _git("rev-parse", "-q", "--verify", "origin/main", cwd=SYNC).returncode == 0:
            _git("reset", "-q", "--hard", "origin/main", cwd=SYNC)
        mesclar(DIR, SYNC)
        _git("add", "-A", cwd=SYNC)
        if _git("status", "--porcelain", cwd=SYNC).stdout.strip():
            r = _git(*identidade, "commit", "-q", "-m", f"constancia: {os.uname().nodename} {agora_iso()}", cwd=SYNC)
            if r.returncode:
                return False, "Erro ao registrar os dados: " + _erro(r)
        elif _git("rev-parse", "-q", "--verify", "HEAD", cwd=SYNC).returncode:
            return True, "Nada para sincronizar ainda."
        elif _git("rev-parse", "HEAD", cwd=SYNC).stdout == _git("rev-parse", "-q", "--verify", "origin/main",
                                                             cwd=SYNC).stdout:
            return True, f"Sincronizado às {datetime.now():%H:%M}."
        r = _git("push", "--quiet", "-u", "origin", "main", cwd=SYNC)
        if r.returncode == 0:
            return True, f"Sincronizado às {datetime.now():%H:%M}."
    return False, "Não consegui enviar os dados: " + _erro(r)


