        # --- editor do desenho ---
        def abrir_desenho():
            w = janela_auxiliar("desenho", "Desenho no gráfico", -1, -1, redimensionavel=False)
            if not w:
                return
            a = Atividade()
            dias = a.desenho  # o mesmo conjunto que o gráfico do editor mostra
            inicio = a.hoje - timedelta(days=(a.hoje.weekday() + 1) % 7 + 7 * 8)
            semanas = a.semanas(53, inicio)
            pagina = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                             margin_top=18, margin_bottom=18, margin_start=22, margin_end=22)
            w.set_child(pagina)
            pagina.append(rotulo("Clique ou arraste para marcar os dias que formam o seu desenho. No gráfico, os dias "
                                 "marcados aparecem com contorno e ficam cheios quando você usa o computador ou "
                                 "conclui tarefas neles. O editor mostra as últimas 8 semanas e as próximas 44.",
                                 wrap=True, max_width_chars=90))
            tela = Gtk.DrawingArea(content_width=GRAFICO_LARGURA, content_height=GRAFICO_ALTURA)
            tela.set_draw_func(lambda _a, cr, largura, _h: desenhar_grafico(cr, largura, a, cfg, semanas, futuro=True))
            pagina.append(tela)
            contagem = rotulo("", "constancia-legenda", hexpand=True)
            modo = {"marcar": True}

            def atualizar():
                contagem.set_label(f"{len(dias)} {plural(len(dias), 'dia marcado', 'dias marcados')}")
                tela.queue_draw()

            def dia_em(x, y):
                i, r = int(x - MARGEM_ESQ) // PASSO, int(y - MARGEM_TOPO) // PASSO
                if x < MARGEM_ESQ or y < MARGEM_TOPO or not (0 <= i < len(semanas) and 0 <= r < 7):
                    return None
                return semanas[i][r].isoformat()

            def pintar(d):
                if d and (d in dias) != modo["marcar"]:
                    (dias.add if modo["marcar"] else dias.discard)(d)
                    atualizar()

            def ao_comecar(_g, x, y):
                d = dia_em(x, y)
                modo["marcar"] = d not in dias
                pintar(d)

            def ao_arrastar(g, dx, dy):
                _ok, x0, y0 = g.get_start_point()
                pintar(dia_em(x0 + dx, y0 + dy))

            arrasto = Gtk.GestureDrag()
            arrasto.connect("drag-begin", ao_comecar)
            arrasto.connect("drag-update", ao_arrastar)
            arrasto.connect("drag-end", lambda *_: gravar_desenho(dias))
            tela.add_controller(arrasto)

            def limpar(*_):
                dias.clear()
                gravar_desenho(dias)
                atualizar()

            rodape = Gtk.Box(spacing=12)
            apagar = Gtk.Button(label="Limpar desenho")
            apagar.connect("clicked", limpar)
            rodape.append(contagem)
            rodape.append(apagar)
            pagina.append(rodape)
