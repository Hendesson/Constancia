def icone_clima(codigo):
    if codigo == 113: return "☀️"
    if codigo == 116: return "⛅"
    if codigo in (119, 122): return "☁️"
    if codigo in (143, 248, 260): return "🌫️"
    if codigo in (200, 386, 389, 392, 395): return "⛈️"
    if codigo in (179, 227, 230, 323, 326, 329, 332, 335, 338, 368, 371): return "❄️"
    return "🌧️"


def obter_clima(forcar=False):
    """Clima atual e previsão de 3 dias; usa cache e devolve None se não houver dados."""
    antigo = ler_json(CLIMA) or None
    if antigo and not forcar and time.time() - antigo.get("quando", 0) < CLIMA_TTL:
        return antigo
    try:
        import urllib.parse
        import urllib.request
        cidade = urllib.parse.quote(ler(CIDADE)[0]) if ler(CIDADE) else ""
        req = urllib.request.Request(f"https://wttr.in/{cidade}?format=j1&lang=pt", headers={"User-Agent": "curl/8"})
        d = json.load(urllib.request.urlopen(req, timeout=6))
        c = d["current_condition"][0]
        novo = {
            "quando": time.time(),
            "cidade": ler(CIDADE)[0] if ler(CIDADE) else d["nearest_area"][0]["areaName"][0]["value"],
            "temp": int(c["temp_C"]),
            "sensacao": int(c["FeelsLikeC"]),
            "descricao": c.get("lang_pt", c["weatherDesc"])[0]["value"].strip(),
            "umidade": int(c["humidity"]),
            "vento": int(c["windspeedKmph"]),
            "codigo": int(c["weatherCode"]),
            "previsao": [[int(w["mintempC"]), int(w["maxtempC"])] for w in d["weather"][:3]],
        }
        gravar_json(CLIMA, novo)
        return novo
    except Exception:
        return antigo


def mostrar_clima(forcar=False):
    c = obter_clima(forcar)
    if not c:
        print(fraco("clima indisponível (sem internet?)"))
        return
    print(f"{icone_clima(c['codigo'])}  {titulo(c['cidade'])}  {destaque(str(c['temp']) + '°C')} "
          f"{fraco('(sensação ' + str(c['sensacao']) + '°C)')}  {c['descricao']}  "
          f"{fraco('umidade ' + str(c['umidade']) + '%  vento ' + str(c['vento']) + ' km/h')}")
    print("   " + "   ".join(f"{fraco(n)} {destaque(f'{lo}–{hi}°C')}"
                             for n, (lo, hi) in zip(["hoje", "amanhã", "depois"], c["previsao"])))


