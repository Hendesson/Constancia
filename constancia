            secao("Sincronização entre computadores")
            grade.attach(rotulo("Crie um repositório PRIVADO no GitHub e cole o endereço dele aqui, em cada "
                                "computador. Este computador precisa já ter acesso ao GitHub pelo git.",
                                "constancia-legenda", wrap=True, max_width_chars=52), 0, n[0], 2, 1)
            n[0] += 1
            repo = Gtk.Entry(text=cfg["sync_repo"], hexpand=True,
                             placeholder_text="git@github.com:usuario/constancia-dados.git")
            sincroniza = Gtk.Button(label="Sincronizar agora")

            def ao_sincronizar(*_):
                mudar("sync_repo", repo.get_text().strip())
                if cfg["sync_repo"]:
                    sincronizar_em_segundo_plano()
                else:
                    mostrar_sync("Sincronização desligada.")

            repo.connect("activate", ao_sincronizar)
            sincroniza.connect("clicked", ao_sincronizar)
            grade.attach(repo, 0, n[0], 1, 1)
            grade.attach(sincroniza, 1, n[0], 1, 1)
            n[0] += 1
            estado["sync_rotulo"] = rotulo(estado.get("sync_msg", ""), "constancia-legenda",
                                           wrap=True, max_width_chars=52)
            grade.attach(estado["sync_rotulo"], 0, n[0], 2, 1)
            n[0] += 1

            def restaurar(*_):
                rgba = Gdk.RGBA()
                for chave in ("fundo", "destaque", "grafico"):
                    rgba.parse(PADRAO[chave])
                    controles[chave].set_rgba(rgba)
