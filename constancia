def cor(codigo, texto):
    return f"{codigo}{texto}\033[0m" if COR else str(texto)


def titulo(t): return cor("\033[1;31m", t)
def destaque(t): return cor("\033[36m", t)
def fraco(t): return cor("\033[90m", t)


def ler(arq):
    if not os.path.exists(arq):
        return []
    with open(arq, encoding="utf-8") as f:
        return [l for l in f.read().splitlines() if l.strip()]


def gravar(arq, linhas):
    """Grava as linhas; não toca no arquivo se o conteúdo já for esse."""
    linhas = list(linhas)
    if os.path.exists(arq) and ler(arq) == linhas:
        return
    os.makedirs(os.path.dirname(arq), exist_ok=True)
    with open(arq, "w", encoding="utf-8") as f:
        f.writelines(l + "\n" for l in linhas)


def acrescentar(arq, linha):
    os.makedirs(os.path.dirname(arq), exist_ok=True)
    with open(arq, "a", encoding="utf-8") as f:
        f.write(linha + "\n")


def ler_json(arq):
    try:
        with open(arq, encoding="utf-8") as f:
            dados = json.load(f)
        return dados if isinstance(dados, dict) else {}
    except (OSError, ValueError):
        return {}


def gravar_json(arq, dados):
    os.makedirs(os.path.dirname(arq), exist_ok=True)
    with open(arq, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=2, ensure_ascii=False)


def plural(n, um, varios):
    return um if n == 1 else varios


def agora_iso():
    return datetime.now().strftime("%Y-%m-%dT%H:%M:%S")


# ---------- dias de uso ----------

def marcar_hoje():
    hoje = date.today().isoformat()
    if hoje not in ler(USO):
        acrescentar(USO, hoje)


def tela_bloqueada():
    """Pergunta ao systemd-logind se a sessão gráfica está bloqueada."""
    try:
        def loginctl(*args):
            return subprocess.run(["loginctl", *args], capture_output=True, text=True, timeout=5).stdout.strip()
        sessao = loginctl("show-user", str(os.getuid()), "-p", "Display", "--value")
        return bool(sessao) and loginctl("show-session", sessao, "-p", "LockedHint", "--value") == "yes"
    except (OSError, subprocess.SubprocessError):
        return False


# ---------- tarefas ----------

def novo_id(ordem=0):
    """Identificador que, ordenado, segue a ordem de criação (igual em todos os computadores)."""
    return f"{int(time.time() * 1000) + ordem:011x}{os.urandom(2).hex()}"


def ler_tarefas():
    """Tarefas pendentes: [{"id", "texto", "alarme"}]."""
    if os.path.exists(TAREFAS_ANTIGO) and not os.path.exists(TAREFAS):
        gravar(TAREFAS, [f"{novo_id(i)}\t{t}\t" for i, t in enumerate(ler(TAREFAS_ANTIGO))])
        os.remove(TAREFAS_ANTIGO)
    tarefas = []
    for l in ler(TAREFAS):
        c = l.split("\t") + ["", ""]
        tarefas.append({"id": c[0], "texto": c[1], "alarme": c[2]})
    return tarefas


def gravar_tarefas(tarefas):
    gravar(TAREFAS, [f"{t['id']}\t{t['texto']}\t{t['alarme']}" for t in tarefas])


def adicionar(texto, alarme=""):
    tarefas = ler_tarefas()
    tarefas.append({"id": novo_id(), "texto": " ".join(texto.split()), "alarme": alarme})
    gravar_tarefas(tarefas)


def retirar(nums, concluir):
    """Tira as tarefas de números `nums` da lista; se `concluir`, contam no gráfico."""
    tarefas = ler_tarefas()
    retiradas = []
    for n in sorted(set(nums), reverse=True):
        t = tarefas.pop(n - 1)
        if concluir:
            acrescentar(CONCLUIDAS, f"{date.today().isoformat()}\t{t['texto']}\t{t['id']}\t{agora_iso()}")
        acrescentar(REMOVIDAS, t["id"])
        retiradas.append(t["texto"])
    gravar_tarefas(tarefas)
    return retiradas


def interpretar_alarme(texto):
    """"14:30" (hoje, ou amanhã se já passou) ou "25/12 09:00" -> "AAAA-MM-DD HH:MM"."""
    m = re.fullmatch(r"(?:(\d{1,2})/(\d{1,2})\s+)?(\d{1,2})[:h](\d{2})", texto.strip())
    if not m:
        raise ValueError("use HH:MM ou DD/MM HH:MM")
    dia, mes, hora, minuto = (int(x) if x else None for x in m.groups())
    agora = datetime.now()
    if dia is None:
        quando = agora.replace(hour=hora, minute=minuto, second=0, microsecond=0)
        if quando <= agora:
            quando += timedelta(days=1)
    else:
        quando = datetime(agora.year, mes, dia, hora, minuto)
        if quando <= agora:
            quando = quando.replace(year=agora.year + 1)
    return quando.strftime("%Y-%m-%d %H:%M")


def formatar_alarme(alarme):
    if not alarme:
        return ""
    dia, hora = alarme.split(" ")
    return hora if dia == date.today().isoformat() else f"{dia[8:10]}/{dia[5:7]} {hora}"


def definir_alarme(id_tarefa, alarme):
    tarefas = ler_tarefas()
    for t in tarefas:
        if t["id"] == id_tarefa:
            t["alarme"] = alarme
    gravar_tarefas(tarefas)


def alarmes_vencidos():
    """Devolve as tarefas cujo alarme já chegou e desarma esses alarmes."""
    agora = datetime.now().strftime("%Y-%m-%d %H:%M")
    tarefas = ler_tarefas()
    vencidas = [t for t in tarefas if t["alarme"] and t["alarme"] <= agora]
    if vencidas:
        for t in vencidas:
            t["alarme"] = ""
        gravar_tarefas(tarefas)
    return vencidas


def mostrar_tarefas():
    tarefas = ler_tarefas()
    if not tarefas:
        print(f"{titulo('Tarefas')}  {fraco('nenhuma pendente — adicione com')} {destaque('constancia add ...')}")
        return
    print(f"{titulo('Tarefas')}  {fraco('(constancia add ... / constancia ok N)')}")
    for i, t in enumerate(tarefas, 1):
        alarme = fraco(f"  (alarme {formatar_alarme(t['alarme'])})") if t["alarme"] else ""
        print(f"{destaque(f'{i:3}')} {t['texto']}{alarme}")


def numeros(args):
    total = len(ler_tarefas())
    try:
        nums = [int(a) for a in args]
    except ValueError:
        nums = []
    if not nums or min(nums) < 1 or max(nums) > total:
        sys.exit("Informe o número da tarefa (veja a lista com: constancia tarefas)")
    return nums


# ---------- desenho e exclusão do histórico ----------

def ler_desenho():
    """Dias marcados para formar um desenho no gráfico."""
    return {l for l in ler(DESENHO) if not l.startswith("#")}


def gravar_desenho(dias):
    gravar(DESENHO, [f"# {agora_iso()}"] + sorted(dias))


def excluir_historico():
    """Apaga dias de uso e tarefas concluídas (as pendentes ficam)."""
    gravar(LIMPEZA, [agora_iso()])
    gravar(CONCLUIDAS, [])
    gravar(USO, [date.today().isoformat()])


# ---------- pontuação e gráfico ----------

def nivel(pontos):
    return 0 if pontos <= 0 else 1 if pontos == 1 else 2 if pontos == 2 else 3 if pontos <= 4 else 4


def inicio_do_periodo(periodo, hoje):
    """Primeiro dia de: dia, semana (começa no domingo), mes, ano; None para tudo."""
    if periodo == "dia":
        return hoje
    if periodo == "semana":
        return hoje - timedelta(days=(hoje.weekday() + 1) % 7)
    if periodo == "mes":
        return hoje.replace(day=1)
    if periodo == "ano":
        return hoje.replace(month=1, day=1)
    return None


class Atividade:
    def __init__(self):
        self.hoje = date.today()
        self.uso = set(ler(USO))
        self.desenho = ler_desenho()
        self.historico = {}  # dia -> [tarefas concluídas]
        for l in ler(CONCLUIDAS):
            c = l.split("\t") + [""]
            self.historico.setdefault(c[0], []).append(c[1])
        self.feitas = Counter({d: len(t) for d, t in self.historico.items()})
        self.total_feitas = sum(self.feitas.values())
        self.seguidos, d = 0, self.hoje
        while self.pontos(d):
            self.seguidos += 1
            d -= timedelta(days=1)
        self.recorde = self.maior_sequencia(self.dias_ativos())

    @staticmethod
    def maior_sequencia(dias):
        maior, atual, anterior = 0, 0, None
        for d in dias:
            atual = atual + 1 if anterior and d - anterior == timedelta(days=1) else 1
            maior, anterior = max(maior, atual), d
        return maior

    def pontos(self, d):
        return (d.isoformat() in self.uso) + self.feitas[d.isoformat()]

    def dias_ativos(self, inicio=None):
        """Dias com uso ou tarefa concluída, em ordem crescente (a partir de `inicio`)."""
        dias = set()
        for d in self.uso | set(self.historico):
            try:
                dias.add(date.fromisoformat(d))
            except ValueError:
                pass
        return sorted(d for d in dias if inicio is None or d >= inicio)

    def resumo(self, periodo):
        """Números de um período: dia, semana, mes, ano ou tudo."""
        inicio = inicio_do_periodo(periodo, self.hoje)
        ativos = self.dias_ativos(inicio)
        feitas = {d: self.feitas[d.isoformat()] for d in ativos if self.feitas[d.isoformat()]}
        melhor = max(feitas, key=feitas.get) if feitas else None
        return {
            "dias": ativos,
            "dias_de_uso": sum(1 for d in ativos if d.isoformat() in self.uso),
            "tarefas": sum(feitas.values()),
            "dias_com_tarefa": len(feitas),
            "sequencia": self.maior_sequencia(ativos),
            "melhor_dia": melhor,
            "melhor_dia_tarefas": feitas.get(melhor, 0),
        }

    def semanas(self, n, inicio=None):
        """n semanas (domingo a sábado); por padrão as últimas, terminando na semana de hoje."""
        if inicio is None:
            inicio = self.hoje - timedelta(days=(self.hoje.weekday() + 1) % 7 + 7 * (n - 1))
        return [[inicio + timedelta(days=7 * s + r) for r in range(7)] for s in range(n)]

    def por_semana(self, n):
        """[(primeiro dia da semana, tarefas concluídas)] das últimas n semanas."""
        return [(s[0], sum(self.feitas[d.isoformat()] for d in s)) for s in self.semanas(n)]

    def descrever(self, d):
        partes = []
        if d.isoformat() in self.uso:
            partes.append("usou o computador")
        f = self.feitas[d.isoformat()]
        if f:
            partes.append(f"{f} {plural(f, 'tarefa concluída', 'tarefas concluídas')}")
        if d.isoformat() in self.desenho:
            partes.append("faz parte do desenho")
        return f"{d.day} de {MESES[d.month - 1]}: " + (", ".join(partes) or "sem atividade")


def data_longa(d):
    return f"{d.day} de {MESES[d.month - 1]} de {d.year} · {DIAS_SEMANA[d.weekday()]}"


def rotulos_meses(semanas):
    """[(índice da semana, nome do mês)] sem sobrepor rótulos vizinhos."""
    rotulos, livre, anterior = [], 0, None
    for i, s in enumerate(semanas):
        if s[0].month != anterior and i >= livre and i + 2 <= len(semanas):
            rotulos.append((i, MESES[s[0].month - 1]))
            livre = i + 2
        anterior = s[0].month
    return rotulos


def linha_resumo(a):
    return (f"{len(a.uso)} {plural(len(a.uso), 'dia de uso', 'dias de uso')} · "
            f"{a.total_feitas} {plural(a.total_feitas, 'tarefa concluída', 'tarefas concluídas')} · "
            f"{a.seguidos} {plural(a.seguidos, 'dia seguido', 'dias seguidos')}")


