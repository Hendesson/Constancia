def gerar_css(cfg):
    claro = fundo_claro(cfg)
    trocas = {
        "@FUNDO@": ", ".join(str(round(c * 255)) for c in rgb(cfg["fundo"])),
        "@OPACIDADE@": str(max(30, min(100, cfg["opacidade"])) / 100),
        "@TEXTO@": "#1c1c1e" if claro else "#e8e8ea",
        "@T@": "0, 0, 0" if claro else "255, 255, 255",
        "@DESTAQUE@": cfg["destaque"],
        "@GRAFICO@": cfg["grafico"],
    }
    css = CSS
    for marca, valor in trocas.items():
        css = css.replace(marca, valor)
    return css


