            i, r = int(x - MARGEM_ESQ) // PASSO, int(y - MARGEM_TOPO) // PASSO
            if x < MARGEM_ESQ or y < MARGEM_TOPO or not (0 <= i < len(semanas) and 0 <= r < 7) or semanas[i][r] > a.hoje:
                return False
            dica.set_text(a.descrever(semanas[i][r]))
            return True

