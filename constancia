def rgb(hexa):
    try:
        h = hexa.lstrip("#")
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except (ValueError, AttributeError):
        return (0.5, 0.5, 0.5)


def fundo_claro(cfg):
    r, g, b = rgb(cfg["fundo"])
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.6


# ---------- desenho com cairo (painel e imagem para compartilhar) ----------

CELULA, PASSO, MARGEM_ESQ, MARGEM_TOPO = 11, 14, 30, 18
GRAFICO_LARGURA = MARGEM_ESQ + 53 * PASSO
GRAFICO_ALTURA = MARGEM_TOPO + 7 * PASSO
ALFAS = [0.30, 0.52, 0.76, 1.0]  # intensidade da cor do gráfico nos níveis 1 a 4


def semanas_que_cabem(largura):
    return max(4, min(53, int(largura - MARGEM_ESQ) // PASSO))


def desenhar_grafico(cr, largura, atividade, cfg=PADRAO, semanas=None, futuro=False):
    """Desenha o gráfico de atividade. Dias do desenho ganham contorno enquanto vazios
    e ficam na cor cheia quando têm atividade. `futuro` mostra também os dias que virão."""
    import math
    if semanas is None:
        semanas = atividade.semanas(semanas_que_cabem(largura))
    texto = (0, 0, 0) if fundo_claro(cfg) else (1, 1, 1)
    base, contorno = rgb(cfg["grafico"]), rgb(cfg["destaque"])
    cr.select_font_face("sans-serif")
    cr.set_font_size(10)
    cr.set_source_rgba(*texto, 0.55)
    for i, nome in rotulos_meses(semanas):
        cr.move_to(MARGEM_ESQ + i * PASSO, 10)
        cr.show_text(nome)
    for r, nome in ((1, "seg"), (3, "qua"), (5, "sex")):
        cr.move_to(0, MARGEM_TOPO + r * PASSO + CELULA - 2)
        cr.show_text(nome)

    def forma(x, y, folga=0.0):
        t, raio = CELULA - 2 * folga, 2.5
        x, y = x + folga, y + folga
        cr.new_sub_path()
        if cfg["formato"] == "redondo":
            cr.arc(x + t / 2, y + t / 2, t / 2, 0, 2 * math.pi)
        else:
            cr.arc(x + t - raio, y + raio, raio, -math.pi / 2, 0)
            cr.arc(x + t - raio, y + t - raio, raio, 0, math.pi / 2)
            cr.arc(x + raio, y + t - raio, raio, math.pi / 2, math.pi)
            cr.arc(x + raio, y + raio, raio, math.pi, 3 * math.pi / 2)
        cr.close_path()

    for i, semana in enumerate(semanas):
        for r, dia in enumerate(semana):
            if dia > atividade.hoje and not futuro:
                continue
            x, y = MARGEM_ESQ + i * PASSO, MARGEM_TOPO + r * PASSO
            pontos = atividade.pontos(dia)
            marcado = dia.isoformat() in atividade.desenho
            forma(x, y)
            if pontos and marcado:
                cr.set_source_rgba(*base, 1)
            elif pontos:
                cr.set_source_rgba(*base, ALFAS[nivel(pontos) - 1])
            else:
                cr.set_source_rgba(*texto, 0.10)
            cr.fill()
            if marcado and not pontos:
                forma(x, y, 0.75)
                cr.set_source_rgba(*contorno, 1)
                cr.set_line_width(1.5)
                cr.stroke()


def desenhar_barras(cr, largura, altura, valores, cor_barra, cor_texto):
    """Barras de tarefas concluídas por semana; valores = [(primeiro dia, total)]."""
    cr.select_font_face("sans-serif")
    cr.set_font_size(10)
    passo = largura / max(1, len(valores))
    barra = min(28, passo * 0.6)
    topo, base = 14, altura - 16
    maior = max(1, max(v for _, v in valores))
    for i, (dia, v) in enumerate(valores):
        x = i * passo + (passo - barra) / 2
        h = max(2, (base - topo) * v / maior)
        cr.set_source_rgba(*cor_barra, 1 if v else 0.25)
        cr.rectangle(x, base - h, barra, h)
        cr.fill()
        cr.set_source_rgba(*cor_texto, 0.6)
        for texto, y in ((str(v) if v else "", base - h - 3), (f"{dia.day:02}/{dia.month:02}", altura - 3)):
            cr.move_to(i * passo + (passo - cr.text_extents(texto).width) / 2, y)
            cr.show_text(texto)


def gerar_imagem(caminho, cfg=None, com_resumo=True):
    """Salva um PNG para compartilhar: o gráfico, com ou sem o título e o resumo acima dele."""
    import cairo
    cfg = cfg or ler_config()
    a = Atividade()
    margem, escala = 32, 2
    topo = 80 if com_resumo else margem - 6
    largura, altura = GRAFICO_LARGURA + 2 * margem, GRAFICO_ALTURA + topo + 28
    superficie = cairo.ImageSurface(cairo.FORMAT_ARGB32, largura * escala, altura * escala)
    cr = cairo.Context(superficie)
    cr.scale(escala, escala)
    cr.set_source_rgb(*rgb(cfg["fundo"]))
    cr.paint()
    texto = (0, 0, 0) if fundo_claro(cfg) else (1, 1, 1)
    if com_resumo:
        cr.select_font_face("sans-serif", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(17)
        cr.set_source_rgb(*rgb(cfg["destaque"]))
        cr.move_to(margem, 40)
        cr.show_text("Constância")
        cr.select_font_face("sans-serif")
        cr.set_font_size(12)
        cr.set_source_rgba(*texto, 0.8)
        cr.move_to(margem, 62)
        cr.show_text(f"{linha_resumo(a)} · recorde de {a.recorde} {plural(a.recorde, 'dia seguido', 'dias seguidos')}")
    cr.translate(margem, topo)
    desenhar_grafico(cr, GRAFICO_LARGURA, a, cfg)
    os.makedirs(os.path.dirname(os.path.abspath(caminho)), exist_ok=True)
    superficie.write_to_png(caminho)
    return caminho


